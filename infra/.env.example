# Copy to  Z:\ruslan\wordpress-test\.env  and fill in.
# NEVER commit the real .env — it is in .gitignore.
#
# These reach PHP as environment variables and are turned into constants by
# WORDPRESS_CONFIG_EXTRA in docker-compose.yaml, so no key is ever written to
# the wp_options table (and therefore never ends up in a database backup).

# Salt for hashing visitor IPs before storing them. Any long random string.
# Changing it invalidates all existing rate-limit history — that is expected.
AICAKE_IP_SALT=change-me-to-something-long-and-random

# Image generation — fal.ai (FLUX.2). https://fal.ai/dashboard/keys
AICAKE_FAL_KEY=

# Image generation — Google Gemini. https://aistudio.google.com/apikey
AICAKE_GEMINI_KEY=

# Image generation — OpenAI (optional, third comparison point).
AICAKE_OPENAI_KEY=

# LLM used for translation + moderation in one call. Can be the same key as
# one of the above depending on which provider we settle on.
AICAKE_LLM_KEY=
